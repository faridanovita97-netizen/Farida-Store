<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FARIDA STORE - HD 4K SW BOOSTER</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Poppins:wght@600&display=swap');
  body {
    margin:0; min-height:100vh; background:#020a1e;
    background: radial-gradient(circle at 20% 20%, #0a2a8a 0%, #020a1e 50%, #000000 100%);
    color:white; font-family:'Poppins', sans-serif;
    display:flex; justify-content:center; align-items:center; padding:20px;
  }
.card {
    width:100%; max-width:420px; background: linear-gradient(180deg, rgba(0, 80, 255, 0.2), rgba(0,0,0,0.5));
    border:1px solid #2a5bff; border-radius:28px; padding:22px;
    box-shadow: 0 0 30px #0040ff88, inset 0 0 15px #ffffff22;
    position:relative; overflow:hidden;
  }
.card::before{
    content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%;
    background: repeating-linear-gradient(90deg, transparent, transparent 20px, #0040ff11 21px);
    animation: move 3s linear infinite; pointer-events:none;
  }
  @keyframes move { to { transform: translateX(20px); } }
.title {
    font-family:'Orbitron', sans-serif; font-weight:900; font-size:28px;
    text-align:center; color:#fff; text-shadow: 0 0 10px #00aaff, 0 0 20px #0055ff;
    letter-spacing:2px;
  }
.sub { text-align:center; font-size:12px; opacity:0.7; margin-bottom:18px; letter-spacing:3px; color:#6aa8ff; }
.upload-area {
    border:2px dashed #2a5bff; border-radius:18px; padding:30px 15px; text-align:center;
    background: rgba(0, 40, 150, 0.3); cursor:pointer; transition:0.3s;
  }
.upload-area:hover { background: rgba(0, 60, 255, 0.4); box-shadow:0 0 20px #0040ff; }
.upload-area span { display:block; margin-top:10px; font-size:13px; }
  canvas, video { width:100%; border-radius:14px; margin-top:15px; display:none; box-shadow:0 0 15px #0055ff; }
.btn {
    width:100%; padding:14px; margin-top:14px; border:none; border-radius:12px;
    font-family:'Orbitron', sans-serif; font-weight:700; font-size:14px; letter-spacing:1px;
    background: linear-gradient(90deg, #0040ff, #00aaff); color:white;
    box-shadow:0 0 15px #0040ff; cursor:pointer; transition:0.2s;
  }
.btn:active { transform:scale(0.97); }
.badge { display:flex; gap:8px; margin-top:18px; }
.badge div { flex:1; background:rgba(0,80,255,0.25); border:1px solid #2a5bff; border-radius:10px; padding:8px; font-size:11px; text-align:center; }
</style>
</head>
<body>
<div class="card">
  <div class="title">HD 4K SW BOOSTER</div>
  <div class="sub">FARIDA STORE TECHNOLOGY</div>

  <label class="upload-area" for="fileInput">
    <div style="font-size:40px;">⚡</div>
    <span>Tap untuk Upload Foto / Video</span>
    <span style="opacity:0.5; font-size:10px;">Support JPG, PNG, MP4 - Auto HD 4K</span>
  </label>
  <input type="file" id="fileInput" accept="image/*,video/*" hidden>

  <canvas id="canvas"></canvas>
  <video id="videoPreview" controls playsinline></video>

  <button class="btn" id="processBtn" style="display:none;">✨ PROSES JADI HD 4K</button>
  <button class="btn" id="downloadBtn" style="display:none; background:linear-gradient(90deg, #00ffaa, #00aaff);">⬇ DOWNLOAD HASIL HD</button>

  <div class="badge">
    <div>1 - UPLOAD FILE</div>
    <div>2 - HD PROCESS</div>
    <div>3 - UPLOAD SW</div>
  </div>
</div>

<script>
const fileInput = document.getElementById('fileInput');
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d', {willReadFrequently:true});
const videoPreview = document.getElementById('videoPreview');
const processBtn = document.getElementById('processBtn');
const downloadBtn = document.getElementById('downloadBtn');
let fileType = '';

fileInput.onchange = e => {
  const file = e.target.files[0];
  if(!file) return;
  fileType = file.type;
  const url = URL.createObjectURL(file);

  if(fileType.includes('image')){
    videoPreview.style.display='none';
    const img = new Image();
    img.onload = () => {
      const targetW = 2160;
      const targetH = 3840;
      let w = img.width, h = img.height;
      let scale = Math.max(targetW/w, targetH/h);
      let newW = w*scale, newH = h*scale;

      canvas.width = targetW;
      canvas.height = targetH;
      canvas.style.display='block';

      ctx.drawImage(img, 0, 0, targetW, targetH);
      ctx.filter = 'blur(30px) brightness(0.6) saturate(2)';
      ctx.drawImage(canvas, 0, 0);

      ctx.filter = 'contrast(1.15) saturate(1.3) sharpen(0)';
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      let x = (targetW - newW)/2;
      let y = (targetH - newH)/2;
      ctx.drawImage(img, x, y, newW, newH);

      processBtn.style.display='block';
    }
    img.src = url;
  } else {
    canvas.style.display='none';
    videoPreview.src = url;
    videoPreview.style.display='block';
    processBtn.innerText = '✨ VIDEO SIAP (HD TANPA KOMPRES)';
  }
};

processBtn.onclick = () => {
  if(fileType.includes('image')){
    ctx.filter = 'contrast(1.2) saturate(1.4) brightness(1.05)';
    ctx.drawImage(canvas, 0, 0);
    let grad = ctx.createRadialGradient(canvas.width/2, canvas.height/2, 0, canvas.width/2, canvas.height/2, canvas.width);
    grad.addColorStop(0, 'transparent');
    grad.addColorStop(1, 'rgba(0, 60, 255, 0.35)');
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,canvas.width, canvas.height);
  }
  downloadBtn.style.display='block';
  processBtn.innerText = '✅ SUDAH HD 4K!';
};

downloadBtn.onclick = () => {
  if(fileType.includes('image')){
    const link = document.createElement('a');
    link.download = `FARIDA-HD4K-${Date.now()}.png`;
    link.href = canvas.toDataURL('image/png', 1.0);
    link.click();
  } else {
    alert('Untuk Video: Karena WA kompres video, triknya upload via "Dokumen" di SW, atau pakai file dari preview ini. File ini sudah di-keep kualitas HD.');
  }
};
</script>
</body>
</html>
